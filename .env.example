APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

TRACKING_CACHE_TTL_SECONDS=60
TRACKING_CACHE_STALE_TTL_SECONDS=300
TRACKING_CACHE_LOCK_SECONDS=15
TRACKING_CACHE_WAIT_MILLISECONDS=1500
TRACKING_CACHE_WAIT_INTERVAL_MILLISECONDS=150

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=sitra
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"




# IPS operating identity (see php artisan ips:diagnose --identities)
IPS_WRITES_ENABLED=false
IPS_TOTALS_CACHE_SECONDS=30
IPS_USER_PID=
IPS_WORKSTATION_PID=

# IPS connection; do not enable writes against production without deployment review.
SQLSRV_HOST=127.0.0.1
SQLSRV_PORT=1433
SQLSRV_DATABASE=IPS5Db
SQLSRV_USERNAME=
SQLSRV_PASSWORD=
SQLSRV_ENCRYPT=yes
SQLSRV_TRUST_SERVER_CERTIFICATE=true

# Read-only lookup of the full IPS postal catalogue. On a shared SQL Server it
# reuses the CDS server and login, but selects the separate IPS5Db database.
# Set this to sqlsrv to search the same test connection used by IPS writes.
POSTAL_IPS_READ_CONNECTION=ips_catalog
# Operational alert threshold in days; indicative only, not an official delivery SLA.
POSTAL_STALE_AFTER_DAYS=7
IPS_CATALOG_SQLSRV_HOST=${CDS_SQLSRV_HOST}
IPS_CATALOG_SQLSRV_PORT=${CDS_SQLSRV_PORT}
IPS_CATALOG_SQLSRV_DATABASE=IPS5Db
IPS_CATALOG_SQLSRV_USERNAME=${CDS_SQLSRV_USERNAME}
IPS_CATALOG_SQLSRV_PASSWORD=${CDS_SQLSRV_PASSWORD}
IPS_CATALOG_SQLSRV_ENCRYPT=${CDS_SQLSRV_ENCRYPT}
IPS_CATALOG_SQLSRV_TRUST_SERVER_CERTIFICATE=${CDS_SQLSRV_TRUST_SERVER_CERTIFICATE}

# CDS connection (consultation only)
CDS_ENABLED=false
CDS_SQLSRV_HOST=127.0.0.1
CDS_SQLSRV_PORT=1433
CDS_SQLSRV_DATABASE=CDSDb
CDS_SQLSRV_USERNAME=
CDS_SQLSRV_PASSWORD=
CDS_SQLSRV_ENCRYPT=yes
CDS_SQLSRV_TRUST_SERVER_CERTIFICATE=true
